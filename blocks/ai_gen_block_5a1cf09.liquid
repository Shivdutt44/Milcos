{% doc %}
  @prompt
    Create rich text section with existing font,color platte and style
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rich-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-rich-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
    margin-bottom: {{ block.settings.heading_spacing }}px;
    {% if block.settings.heading_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    line-height: 1.4;
    margin-bottom: {{ block.settings.subheading_spacing }}px;
    {% if block.settings.subheading_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} p {
    margin-bottom: 16px;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} h1,
  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} h2,
  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} h3,
  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} h4,
  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} h5,
  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} strong {
    color: {{ block.settings.accent_color }};
    font-weight: 700;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: color 0.3s ease;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} ul,
  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} ol {
    margin-bottom: 16px;
    padding-left: 20px;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_spacing }}px;
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_bg_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    {% if block.settings.button_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_bg_color }};
  }

  @media screen and (max-width: 767px) {
    .ai-rich-text-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_size }}px;
    }

    .ai-rich-text-{{ ai_gen_id }} .ai-rich-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-rich-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-rich-text-container-{{ ai_gen_id }}">
    {% if block.settings.subheading != blank %}
      <div class="ai-rich-text-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-rich-text-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.content != blank %}
      <div class="ai-rich-text-content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <div class="ai-rich-text-button-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-rich-text-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

