{% liquid
  assign f_messenger = shop.metafields.foxecom-bs-kit.messenger.value | default: shop.metafields.foxecom-bs-kit.messenger
  assign page_id = f_messenger.page_id
  assign language = f_messenger.language
%}

{% if f_messenger != blank  and f_messenger.active == true and page_id != blank %}
  {% style %}
    @media (max-width: 767px) {
      .fb_dialog_content iframe {
        margin: 0 !important;
        bottom: 64px !important;
      }
      #scroll-to-top-button {bottom: 130px}
    }
  {% endstyle %}
<!-- Messenger Chat Plugin Code -->
<div id="fb-root"></div>

<!-- Your Chat Plugin code -->
<div id="fb-customer-chat" class="fb-customerchat">
</div>
<script>
    var chatbox = document.getElementById('fb-customer-chat');
    chatbox.setAttribute("page_id", {{ page_id | json }});
    chatbox.setAttribute("attribution", "setup_tool");

    function initFbChat() {
      if (window.__foxkitFbLoaded) return;
      window.__foxkitFbLoaded = true;

      window.fbAsyncInit = function() {
        FB.init({
          xfbml: true,
          version: 'v11.0'
        });
      };

      var js = document.createElement('script');
      js.id = 'facebook-jssdk';
      js.src = 'https://connect.facebook.net/{{ language }}/sdk/xfbml.customerchat.js';
      js.async = true;
      var fjs = document.getElementsByTagName('script')[0];
      if (fjs) {
        fjs.parentNode.insertBefore(js, fjs);
      } else {
        document.head.appendChild(js);
      }
    }

    function loadFbChatOnInteraction() {
      ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function(eventName) {
        window.addEventListener(eventName, initFbChat, { once: true, passive: true });
      });

      window.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') {
          initFbChat();
        }
      }, { passive: true });

      setTimeout(initFbChat, 5000);
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      loadFbChatOnInteraction();
    } else {
      window.addEventListener('DOMContentLoaded', loadFbChatOnInteraction);
    }
</script>
{% endif %}
