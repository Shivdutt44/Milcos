  // Defer non-critical third-party scripts to improve caching and reduce TBT.
  (function(){
    var hosts = ['cdn3.hextom.com','hextom.com','loox.io','static.klaviyo.com','shopifypreview.com','connect.facebook.net'];
    function shouldDefer(src){ if(!src) return false; for (var i=0;i<hosts.length;i++){ if (src.indexOf(hosts[i])>-1) return true; } return false; }

    var deferred = [];

    function captureScript(s){
      try{
        if(!s || !s.src) return;
        if(s.dataset && s.dataset.deferProcessed) return;
        var src = s.getAttribute('src') || '';
        if(!shouldDefer(src)) return;
        s.dataset.deferProcessed = '1';
        var attrs = { async: s.async, defer: s.defer, type: s.type, id: s.id, crossorigin: s.getAttribute('crossorigin') };
        var parent = s.parentNode;
        if(parent) parent.removeChild(s);
        deferred.push({ src: src, attrs: attrs });
      }catch(e){console.warn('captureScript', e)}
    }

    function deferExisting(){
      var scripts = Array.prototype.slice.call(document.querySelectorAll('script[src]'));
      scripts.forEach(function(s){ captureScript(s); });
    }

    function loadDeferred(){
      if(!deferred.length) return;
      deferred.forEach(function(item){
        try{
          var sc = document.createElement('script');
          sc.src = item.src;
          if(item.attrs.crossorigin) sc.setAttribute('crossorigin', item.attrs.crossorigin);
          if(item.attrs.type) sc.type = item.attrs.type;
          sc.async = !!item.attrs.async;
          sc.defer = !!item.attrs.defer;
          document.body.appendChild(sc);
        }catch(e){console.warn('loadDeferred', e)}
      });
      deferred = [];
    }

    // Observe newly injected scripts and capture ones we want to defer
    try{
      var mo = new MutationObserver(function(muts){
        muts.forEach(function(m){
          Array.prototype.slice.call(m.addedNodes||[]).forEach(function(node){
