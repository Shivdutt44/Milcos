              captureScript(node);
            }
          });
        });
      });
      mo.observe(document.documentElement || document, { childList: true, subtree: true });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', deferExisting);
      } else {
        deferExisting();
      }

      var events = ['scroll','mousemove','touchstart','keydown','click'];
      var onInteraction = function(){ try{ mo.disconnect(); }catch(e){}
        loadDeferred();
        events.forEach(function(e){ window.removeEventListener(e, onInteraction); });
      };
      events.forEach(function(e){ window.addEventListener(e, onInteraction, { once: true, passive: true }); });

      if ('requestIdleCallback' in window) requestIdleCallback(loadDeferred, { timeout: 5000 }); else setTimeout(loadDeferred, 5000);
    }catch(e){console.warn('defer-third-party', e)}
