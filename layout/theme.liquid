{%- capture body_classes -%}
template-{{ template.name | handle }} {{ template.name }}-{{ template.suffix }} {{ template.name | append: '-' | append: handle }} {% if cart.item_count == 0 %}cart-empty{% endif %}
{%- endcapture -%}

{% liquid
  assign enable_rtl = settings.enable_rtl
  assign language_support_rtl = settings.language_support_rtl
  if enable_rtl and language_support_rtl != blank
    assign shop_locale = localization.language.iso_code
    assign language_support_rtl_list = language_support_rtl | split: ','
    assign is_rtl = language_support_rtl_list | where: shop_locale
    if is_rtl.size > 0
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
<!doctype html>
<html
  class="no-js supports-no-cookies"
  lang="{{ request.locale.iso_code }}"
  data-template="{{ template.name }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0">
    <meta name="theme-color" content="{{ settings.color_primary }}">

    {%- liquid
      render 'preload'
      render 'SEO'
      render 'social-meta-tags'
      render 'font-face'
    -%}

    {{ content_for_header }}

    {% render 'critical-css' %}
    {% render 'critical-scripts' %}
    {% render 'custom-code-head' %}

    {% comment %}Defer non-critical CSS — load async, not render-blocking{% endcomment %}
    <link rel="preload" href="{{ 'theme.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'theme.css' | asset_url }}"></noscript>
    <link rel="preload" href="{{ 'chunk.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'chunk.css' | asset_url }}"></noscript>

    {% render 'style-tags' %}

    {% comment %}Defer critical JS but load early enough for interactivity{% endcomment %}
    <script src="{{ 'theme-global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'app.min.js' | asset_url }}" defer="defer"></script>

    {% comment %}Delayed third-party scripts — loaded after page load to reduce blocking{% endcomment %}
    <script>
      window._delayThirdParty = function() {
        if (window._thirdPartyLoaded) return;
        window._thirdPartyLoaded = true;
        // Microsoft Clarity
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "wk6mfywz5j");

        // Google Analytics (gtag)
        var gas = document.createElement('script');
        gas.async = true;
        gas.src = 'https://www.googletagmanager.com/gtag/js?id=G-QXZ0NWT2C5';
        document.head.appendChild(gas);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-QXZ0NWT2C5');
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(window._delayThirdParty, { timeout: 2000 });
      } else {
        setTimeout(window._delayThirdParty, 2000);
      }
      window.addEventListener('scroll', function() { window._delayThirdParty(); }, { once: true, passive: true });
    </script>
  </head>

  <body
    id="sf-theme"
    class="{{ body_classes }} relative min-h-screen{% if customer %} customer-logged-in{% endif %}"
    {% if template.name == 'product' %}
      data-product-id="{{ product.id }}"
    {% endif %}
  >
    {% render 'theme-data' %}
    {% section 'annoucement' %}
    {% section 'header' %}
    {% render 'scroll-top-button' %}

    <main role="main" id="MainContent">
      {{ content_for_layout }}
      <div id="cart-drawer-container"></div>
    </main>

    {%- liquid
      section 'footer'
      section 'mobile-sticky-bar'
    -%}

    {% render 'custom-code-body' %}
    {% render 'foxkit-messenger' %}
    {% render 'script-tags' %}
    {% render 'cookie-banner' %}
    
    {% comment %}Defer non-essential JS module loading until after interactive{% endcomment %}
    <script src="{{ 'foxkit-app.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-view.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-card-swatch.min.js' | asset_url }}" defer="defer"></script>
    {%- if settings.enable_predictive_search -%}
      <script src="{{ 'predictive-search.min.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
