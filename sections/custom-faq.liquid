{% capture css %}
<style>
/* Base Styles */
#bse-faq-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  position: relative;
  overflow: hidden;
}

{% if section.settings.bg_image != blank %}
#bse-faq-{{ section.id }} {
  background-image: url("{{ section.settings.bg_image | image_url: width: 2000 }}");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
{% endif %}

/* Wrapper */
#bse-faq-{{ section.id }} .bse-faq-wrapper {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

/* Header Styles */
#bse-faq-{{ section.id }} .bse-heading-container {
  text-align: {{ section.settings.text_alignment }};
  margin-bottom: 50px;
}

#bse-faq-{{ section.id }} .bse-heading {
  font-size: {{ section.settings.heading_size }}px;
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 16px;
  color: {{ section.settings.heading_color }};
  letter-spacing: -0.02em;
}

#bse-faq-{{ section.id }} .bse-subheading {
  font-size: 18px;
  line-height: 1.6;
  color: {{ section.settings.subheading_color }};
  max-width: 600px;
  margin: 0 auto;
}

/* FAQ Grid */
#bse-faq-{{ section.id }} .bse-faq-grid {
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.spacing_between }}px;
}

/* FAQ Item - Base */
#bse-faq-{{ section.id }} .bse-faq-item {
  border-radius: {{ section.settings.border_radius }}px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: {{ section.settings.answer_bg }};
}

/* Layout Styles */
{% case section.settings.layout_style %}
  {% when 'modern' %}
    #bse-faq-{{ section.id }} .bse-faq-item {
      background: {{ section.settings.question_bg }};
      border: 1px solid {{ section.settings.border_color }};
      box-shadow: 0 4px 20px {{ section.settings.shadow_color }};
    }
    
    #bse-faq-{{ section.id }} .bse-faq-item:hover {
      border-color: {{ section.settings.icon_color }};
      box-shadow: 0 8px 30px rgba(0,102,204,0.1);
    }

  {% when 'minimal' %}
    #bse-faq-{{ section.id }} .bse-faq-item {
      background: transparent;
      border-bottom: 1px solid {{ section.settings.border_color }};
      border-radius: 0;
    }
    
    #bse-faq-{{ section.id }} .bse-faq-item:last-child {
      border-bottom: none;
    }
    
    #bse-faq-{{ section.id }} .bse-faq-question {
      padding: 20px 0;
    }
    
    #bse-faq-{{ section.id }} .bse-faq-answer {
      background: transparent;
    }

  {% when 'elegant' %}
    #bse-faq-{{ section.id }} .bse-faq-item {
      background: {{ section.settings.question_bg }};
      box-shadow: 0 10px 40px -10px {{ section.settings.shadow_color }};
    }

  {% when 'bold' %}
    #bse-faq-{{ section.id }} .bse-faq-item {
      background: {{ section.settings.question_bg }};
      border-left: 4px solid {{ section.settings.icon_color }};
      box-shadow: 0 4px 12px {{ section.settings.shadow_color }};
    }
{% endcase %}

/* Question Styles */
#bse-faq-{{ section.id }} .bse-faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  background: {{ section.settings.question_bg }};
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: {{ section.settings.question_size }}px;
  font-weight: {{ section.settings.question_weight }};
  color: {{ section.settings.question_color }};
  position: relative;
  z-index: 2;
}

#bse-faq-{{ section.id }} .bse-faq-question:hover {
  background: {{ section.settings.question_hover_bg }};
}

/* Icon Styles */
#bse-faq-{{ section.id }} .bse-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  color: {{ section.settings.icon_color }};
  transition: transform 0.3s ease;
  flex-shrink: 0;
  margin-left: 16px;
}

#bse-faq-{{ section.id }} .bse-plus-icon,
#bse-faq-{{ section.id }} .bse-minus-icon {
  position: absolute;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

#bse-faq-{{ section.id }} .bse-plus-icon {
  opacity: 1;
  transform: rotate(0deg);
}

#bse-faq-{{ section.id }} .bse-minus-icon {
  opacity: 0;
  transform: rotate(-90deg);
}

#bse-faq-{{ section.id }} .bse-faq-item.active .bse-plus-icon {
  opacity: 0;
  transform: rotate(90deg);
}

#bse-faq-{{ section.id }} .bse-faq-item.active .bse-minus-icon {
  opacity: 1;
  transform: rotate(0deg);
}

/* Answer Styles - FIXED VISIBILITY */
#bse-faq-{{ section.id }} .bse-faq-answer {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  background: {{ section.settings.answer_bg }};
  visibility: hidden;
  transform: translateY(-10px);
}

#bse-faq-{{ section.id }} .bse-faq-item.active .bse-faq-answer {
  max-height: 800px; /* Large enough for content */
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

#bse-faq-{{ section.id }} .bse-answer-content {
  padding: 0 24px 24px;
  color: {{ section.settings.answer_color }};
  font-size: {{ section.settings.answer_size }}px;
  line-height: 1.7;
}

/* Answer Content Styles */
#bse-faq-{{ section.id }} .bse-answer-content p {
  margin: 0 0 16px;
}

#bse-faq-{{ section.id }} .bse-answer-content p:last-child {
  margin-bottom: 0;
}

#bse-faq-{{ section.id }} .bse-answer-content ul,
#bse-faq-{{ section.id }} .bse-answer-content ol {
  margin: 12px 0;
  padding-left: 24px;
}

#bse-faq-{{ section.id }} .bse-answer-content li {
  margin-bottom: 8px;
}

#bse-faq-{{ section.id }} .bse-answer-content a {
  color: {{ section.settings.icon_color }};
  text-decoration: underline;
  transition: opacity 0.2s ease;
}

#bse-faq-{{ section.id }} .bse-answer-content a:hover {
  opacity: 0.8;
}

/* View All Button */
#bse-faq-{{ section.id }} .bse-view-all-container {
  text-align: center;
  margin-top: 50px;
}

#bse-faq-{{ section.id }} .bse-view-all-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 14px 32px;
  background: {{ section.settings.btn_bg }};
  color: {{ section.settings.btn_text }};
  border-radius: {{ section.settings.btn_radius }}px;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

#bse-faq-{{ section.id }} .bse-view-all-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

#bse-faq-{{ section.id }} .bse-view-all-btn svg {
  transition: transform 0.3s ease;
}

#bse-faq-{{ section.id }} .bse-view-all-btn:hover svg {
  transform: translateX(5px);
}

/* Mobile Responsive */
@media screen and (max-width: 768px) {
  #bse-faq-{{ section.id }} {
    padding-left: 16px;
    padding-right: 16px;
  }

  #bse-faq-{{ section.id }} .bse-heading {
    font-size: {{ section.settings.heading_size | times: 0.7 }}px;
  }

  #bse-faq-{{ section.id }} .bse-subheading {
    font-size: 16px;
    padding: 0 16px;
  }

  #bse-faq-{{ section.id }} .bse-faq-question {
    padding: 16px 18px;
    font-size: {{ section.settings.question_size | times: 0.9 }}px;
  }

  #bse-faq-{{ section.id }} .bse-answer-content {
    padding: 0 18px 18px;
    font-size: {{ section.settings.answer_size | times: 0.9 }}px;
  }
}

/* Loading Animation */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

#bse-faq-{{ section.id }} .bse-faq-item {
  animation: fadeInUp 0.5s ease forwards;
  opacity: 0;
}

{% for i in (1..10) %}
#bse-faq-{{ section.id }} .bse-faq-item:nth-child({{ i }}) {
  animation-delay: {{ i | times: 0.05 }}s;
}
{% endfor %}

/* Focus States for Accessibility */
#bse-faq-{{ section.id }} .bse-faq-question:focus-visible {
  outline: 2px solid {{ section.settings.icon_color }};
  outline-offset: 2px;
}
</style>
{% endcapture %}

{{ css | strip_newlines }}

<script>
  (function() {
    'use strict';

    class ModernFAQ {
      constructor(element) {
        this.section = element;
        this.items = this.section.querySelectorAll('.bse-faq-item');
        this.allowMultiple = {{ section.settings.allow_multiple | json }};
        this.autoOpenFirst = {{ section.settings.open_first | json }};

        this.init();
      }

      init() {
        // Auto-open first item if enabled
        if (this.autoOpenFirst && this.items.length > 0) {
          this.openItem(this.items[0]);
        }

        // Add click handlers to all questions
        this.items.forEach((item) => {
          const question = item.querySelector('.bse-faq-question');

          question.addEventListener('click', (e) => this.toggleItem(e, item));

          // Add keyboard support
          question.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.toggleItem(e, item);
            }
          });

          // Set ARIA attributes
          question.setAttribute('role', 'button');
          question.setAttribute('tabindex', '0');
          question.setAttribute('aria-expanded', 'false');

          const answer = item.querySelector('.bse-faq-answer');
          answer.setAttribute('role', 'region');
        });
      }

      toggleItem(event, item) {
        event.preventDefault();

        const isActive = item.classList.contains('active');

        // Close other items if multiple not allowed
        if (!this.allowMultiple && !isActive) {
          this.closeAllItems();
        }

        // Toggle current item
        if (isActive) {
          this.closeItem(item);
        } else {
          this.openItem(item);
        }
      }

      openItem(item) {
        item.classList.add('active');
        const question = item.querySelector('.bse-faq-question');
        question.setAttribute('aria-expanded', 'true');
      }

      closeItem(item) {
        item.classList.remove('active');
        const question = item.querySelector('.bse-faq-question');
        question.setAttribute('aria-expanded', 'false');
      }

      closeAllItems() {
        this.items.forEach(item => this.closeItem(item));
      }
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        const section = document.getElementById('bse-faq-{{ section.id }}');
        if (section) new ModernFAQ(section);
      });
    } else {
      const section = document.getElementById('bse-faq-{{ section.id }}');
      if (section) new ModernFAQ(section);
    }
  })();
</script>
